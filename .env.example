# ubuntu-server-hub — configuração local.
# Copie para .env (cp .env.example .env) ou rode ./install.sh, que cria o .env para você.
# O .env está no .gitignore: NUNCA faça commit dele (pode ter senha).

# ---------------------------------------------------------------- aparência
# Nome grande no canto superior esquerdo. Vazio = hostname da máquina.
HUB_TITLE=
# Linha pequena embaixo do nome. Vazio = modelo do computador lido do DMI (/sys/class/dmi/id).
HUB_SUBTITLE=
# Sobrescreve o modelo do computador mostrado no cartão "Sistema". Vazio = detectado.
HUB_HOST_MODEL=
# Sobrescreve o nome do processador. Vazio = detectado em /proc/cpuinfo.
HUB_CPU_NAME=

# ---------------------------------------------------------------- rede
# 127.0.0.1 = só a própria máquina (acesse por Cloudflare Tunnel, Tailscale ou túnel SSH). Recomendado.
# 0.0.0.0   = qualquer um na sua rede local. Exige HUB_PASSWORD (o hub se recusa a subir sem).
HUB_BIND=127.0.0.1
HUB_PORT=8084

# ---------------------------------------------------------------- login (opcional)
# Senha simples (HTTP Basic). Use uma senha longa e aleatória: openssl rand -base64 24
# Atenção: sem HTTPS a senha trafega legível na rede. Prefira Tailscale ou Cloudflare.
HUB_USER=admin
HUB_PASSWORD=
# Só se você sabe o que está fazendo: permite HUB_BIND na rede SEM senha.
HUB_ALLOW_NO_AUTH=

# Validação do JWT do Cloudflare Access (defesa extra, veja docs/*/cloudflare.md)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ---------------------------------------------------------------- ícones
# Fonte dos ícones (mesma estrutura do dashboard-icons: /tree.json e /svg/<nome>.svg)
HUB_ICON_CDN=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons

# ---------------------------------------------------------------- preenchidos pelo ./install.sh
# Versão do Ubuntu do servidor (a imagem precisa ser a mesma), seu UID/GID, grupo do docker.sock
UBUNTU_VERSION=
HUB_UID=
HUB_GID=
HUB_HOST_USER=
DOCKER_GID=
# Pasta dos dados (atalhos, layout, alertas, token). Padrão: ./data
HUB_DATA_PATH=./data
